<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Tasky.Converters"
                    xmlns:ctrl="using:Tasky.Controls">

    <!-- ── Fonts ──────────────────────────────────────────────────────── -->
    <!-- Consolas on Windows; Menlo is the matching monospace font on macOS -->
    <FontFamily x:Key="MonoFont">Consolas, Menlo, Courier New</FontFamily>

    <!-- ── Converters ─────────────────────────────────────────────────── -->
    <conv:StringHasTextConverter       x:Key="HasText"/>
    <conv:ActiveToBackgroundConverter  x:Key="ActiveBgConv"/>

    <!-- ══════════════════════════════════════════════════════════════════
         COMBOBOX ITEM
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding"    Value="12,9"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="2,1">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource TagBackground}"/>
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
        <Style Selector="^:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource TagBackground}"/>
        </Style>
        <!-- Keyboard highlight (WPF IsHighlighted): the item under the keyboard cursor -->
        <Style Selector="^:focus">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
        <Style Selector="^:focus /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource TagBackground}"/>
        </Style>
        <!-- Selected and highlighted: solid accent (the open list starts on the selected item) -->
        <Style Selector="^:selected:pointerover, ^:selected:focus">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="^:selected:pointerover /template/ Border#Bd, ^:selected:focus /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         COMBOBOX
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="ThemedComboBox" TargetType="ComboBox">
        <Setter Property="Background"          Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush"         Value="Transparent"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="Padding"             Value="12,9"/>
        <Setter Property="MinHeight"           Value="40"/>
        <Setter Property="FontSize"            Value="13"/>
        <Setter Property="Cursor"              Value="Arrow"/>
        <Setter Property="MaxDropDownHeight"   Value="320"/>
        <Setter Property="ItemContainerTheme"  Value="{StaticResource ComboBoxItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="*,24" VerticalAlignment="Center">
                            <ContentControl Grid.Column="0"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding ItemTemplate}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"/>
                            <ctrl:LineIcon Grid.Column="1" Name="Arrow" Size="16"
                                           Data="{StaticResource Icon.ChevronDown}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           RenderTransformOrigin="50%,50%"
                                           IsHitTestVisible="False">
                                <ctrl:LineIcon.Transitions>
                                    <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/></Transitions>
                                </ctrl:LineIcon.Transitions>
                            </ctrl:LineIcon>
                        </Grid>
                    </Border>
                    <Popup Name="PART_Popup" Placement="AnchorAndGravity" PlacementAnchor="BottomLeft" PlacementGravity="BottomRight"
                           WindowManagerAddShadowHint="False"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           IsLightDismissEnabled="True"
                           InheritsTransform="True">
                        <Border MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1" CornerRadius="12"
                                Margin="0,4,0,0" Padding="4,4">
                            <Border.Effect>
                                <DropShadowDirectionEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000"/>
                            </Border.Effect>
                            <!-- The bar column is always reserved, as in the Windows design -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:dropdownopen /template/ Border#MainBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
        <Style Selector="^:dropdownopen /template/ ctrl|LineIcon#Arrow">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#MainBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         INPUT BOX  (TextBox with placeholder via Watermark)
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="MinHeight"       Value="0"/>
        <Setter Property="Background"      Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource PrimaryBlue}"/>
        <Setter Property="SelectionForegroundBrush" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                  <Grid ColumnDefinitions="Auto,*">
                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding InnerLeftContent}"
                                      Foreground="{DynamicResource PlaceholderColor}"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Panel Grid.Column="1" Margin="2,0">
                        <TextBlock Name="PART_Watermark"
                                   Text="{TemplateBinding Watermark}"
                                   Foreground="{DynamicResource PlaceholderColor}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   IsHitTestVisible="False"
                                   IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                        <ScrollViewer Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                      VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                      AllowAutoHide="False">
                            <TextPresenter Name="PART_TextPresenter"
                                           Margin="{TemplateBinding Padding}"
                                           Text="{TemplateBinding Text, Mode=TwoWay}"
                                           CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           TextAlignment="{TemplateBinding TextAlignment}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           LineHeight="{TemplateBinding LineHeight}"
                                           LetterSpacing="{TemplateBinding LetterSpacing}"
                                           PasswordChar="{TemplateBinding PasswordChar}"
                                           RevealPassword="{TemplateBinding RevealPassword}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </ScrollViewer>
                    </Panel>
                  </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.15"/></Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
        </Style>
        <Style Selector="^:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         BUTTONS
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Foreground"      Value="{DynamicResource PrimaryPillForeground}"/>
        <Setter Property="Background"      Value="{DynamicResource PrimaryPillBackground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="18,9"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="999"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="RenderTransform" Value="translateY(-1px)"/></Style>
        <Style Selector="^:pressed"><Setter Property="RenderTransform" Value="scale(0.97)"/></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
    </ControlTheme>

    <ControlTheme x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource ChipBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="18,8"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="999" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.15"/></Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource IconHoverBackground}"/>
        </Style>
        <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.75"/></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
    </ControlTheme>

    <!-- Icon-only button. The icon is muted grey; on hover it turns TextPrimary, or the action colour
         given by a class: attach · postpone · edit · remind · delete · timer · accent -->
    <ControlTheme x:Key="IconButton" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource IconMuted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="6"/>
        <Setter Property="MinWidth"        Value="32"/>
        <Setter Property="MinHeight"       Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource IconHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="^.attach:pointerover">   <Setter Property="Foreground" Value="{DynamicResource IconAttachHover}"/></Style>
        <Style Selector="^.postpone:pointerover"> <Setter Property="Foreground" Value="{DynamicResource IconPostponeHover}"/></Style>
        <Style Selector="^.edit:pointerover">     <Setter Property="Foreground" Value="{DynamicResource IconEditHover}"/></Style>
        <Style Selector="^.remind:pointerover">   <Setter Property="Foreground" Value="{DynamicResource IconReminderHover}"/></Style>
        <Style Selector="^.delete:pointerover">   <Setter Property="Foreground" Value="{DynamicResource IconDeleteHover}"/></Style>
        <Style Selector="^.timer:pointerover">    <Setter Property="Foreground" Value="{DynamicResource Success}"/></Style>
        <Style Selector="^.accent:pointerover">   <Setter Property="Foreground" Value="{DynamicResource PrimaryBlue}"/></Style>
        <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.7"/></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.35"/></Style>
    </ControlTheme>

    <!-- Header row of a collapsible section: content on the left, a chevron that turns when open -->
    <ControlTheme x:Key="CollapsibleHeader" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Padding"    Value="16,14"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                        <ctrl:LineIcon Grid.Column="1" Name="Chevron" Data="{StaticResource Icon.ChevronDown}" Size="18"
                                       Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                            <ctrl:LineIcon.Transitions>
                                <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/></Transitions>
                            </ctrl:LineIcon.Transitions>
                        </ctrl:LineIcon>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.15"/></Transitions>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource IconHoverBackground}"/></Style>
        <Style Selector="^:checked /template/ ctrl|LineIcon#Chevron"><Setter Property="RenderTransform" Value="rotate(180deg)"/></Style>
    </ControlTheme>

    <!-- A whole settings row that is one button (e.g. Recycle Bin) -->
    <ControlTheme x:Key="SettingsRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Padding"    Value="16,12"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Stretch"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.15"/></Transitions>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource IconHoverBackground}"/></Style>
        <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.8"/></Style>
    </ControlTheme>

    <!-- Text button without chrome until hover (Back, inline links) -->
    <ControlTheme x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="Padding"         Value="8,6,10,6"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource IconHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.75"/></Style>
    </ControlTheme>

    <!-- A button that is just its content (custom-drawn content, no chrome) -->
    <ControlTheme x:Key="BareButton" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         SELECTABLE TEXT — read-only text the user can highlight and copy
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="SelectableText" TargetType="SelectableTextBlock">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Margin"          Value="0"/>
        <Setter Property="TextWrapping"    Value="Wrap"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource PrimaryBlue}"/>
        <Setter Property="Cursor"          Value="IBeam"/>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         TYPOGRAPHY
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </ControlTheme>

    <ControlTheme x:Key="SubText" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </ControlTheme>

    <!-- ⓘ next to a field: hover (or keep the pointer on it) to read what the field means -->
    <ControlTheme x:Key="InfoIcon" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="14"/>
        <Setter Property="Foreground"        Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="Margin"            Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor"            Value="Help"/>
        <Setter Property="ToolTip.ShowDelay" Value="0"/>
    </ControlTheme>

    <ControlTheme x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Margin"     Value="0,0,0,6"/>
    </ControlTheme>

    <!-- Small uppercase heading at the top of a SectionCard -->
    <ControlTheme x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize"      Value="11"/>
        <Setter Property="FontWeight"    Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.6"/>
        <Setter Property="Foreground"    Value="{DynamicResource PlaceholderColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </ControlTheme>

    <!-- A titled group of fields or content (edit page, settings, stats) -->
    <ControlTheme x:Key="SectionCard" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
        <Setter Property="Padding"         Value="16"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
    </ControlTheme>

    <!-- Small rounded status tag: Today · overdue · Weekly … (colours set per use) -->
    <ControlTheme x:Key="Tag" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding"      Value="8,2"/>
        <Setter Property="Background"   Value="{DynamicResource SuccessSoft}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         TASK CARD
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="TaskCard" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
        <Setter Property="Padding"         Value="16,14"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         PASSWORD INPUT — matches InputBox
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="PasswordInput" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="PasswordChar" Value="●"/>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         DIALOG FRAME — accent outline that separates a detail dialog
         from the window behind it
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="DialogFrame" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppBackground}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource DialogFrameBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         CHECKMARK BUTTON
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="CheckmarkBox" TargetType="CheckBox">
        <Setter Property="Width"       Value="22"/>
        <Setter Property="Height"      Value="22"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="ToolTip.Tip" Value="Mark as done"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Circle" Width="22" Height="22" CornerRadius="11"
                        Background="{DynamicResource CheckIdle}">
                    <Border.Transitions>
                        <Transitions><BrushTransition Property="Background" Duration="0:0:0.18"/></Transitions>
                    </Border.Transitions>
                    <ctrl:LineIcon Name="Check" Data="{StaticResource Icon.Check}" Size="14" StrokeThickness="3"
                                   Foreground="White" Opacity="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ctrl:LineIcon.Transitions>
                            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions>
                        </ctrl:LineIcon.Transitions>
                    </ctrl:LineIcon>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked">
            <Setter Property="ToolTip.Tip" Value="Completed"/>
        </Style>
        <Style Selector="^:checked /template/ Border#Circle">
            <Setter Property="Background" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="^:checked /template/ ctrl|LineIcon#Check">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="^:pointerover:not(:checked) /template/ Border#Circle">
            <Setter Property="Background" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="^:pointerover:not(:checked) /template/ ctrl|LineIcon#Check">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         ACTIVE TOGGLE SWITCH
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="ActiveToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width"       Value="34"/>
        <Setter Property="Height"      Value="18"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="ToolTip.Tip" Value="Toggle active"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Track" CornerRadius="9" Background="{DynamicResource CheckIdle}"
                        Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                    <Ellipse Name="Thumb" Width="14" Height="14" Fill="White"
                             Margin="2,0,18,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowDirectionEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#000"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Track">
            <Setter Property="Background" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Thumb">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="18,0,2,0"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Track">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         TIMER PLAY / STOP BUTTON — round, ▶ when stopped, ■ while running
    ══════════════════════════════════════════════════════════════════ -->
    <!-- ══ TIMER PLAY / PAUSE BUTTON — round: ▶ when stopped, ❚❚ (with a soft pulse ring) while running ══ -->
    <ControlTheme x:Key="TimerPlayButton" TargetType="ToggleButton">
        <Setter Property="Width"  Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Ellipse Name="Ring" Fill="{DynamicResource Success}" Opacity="0" RenderTransformOrigin="50%,50%">
                        <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Name="Circle" CornerRadius="13" Background="{DynamicResource InputBackground}"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border.Transitions>
                            <Transitions><BrushTransition Property="Background" Duration="0:0:0.18"/></Transitions>
                        </Border.Transitions>
                        <Panel>
                            <ctrl:LineIcon Name="Play" Data="{StaticResource Icon.Play}" IsFilled="True" Size="13" StrokeThickness="2"
                                           Foreground="{DynamicResource TextSecondary}" Margin="1.5,0,0,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ctrl:LineIcon Name="Pause" Data="{StaticResource Icon.Pause}" Size="13" StrokeThickness="3.4"
                                           Foreground="{DynamicResource AppBackground}" IsVisible="False"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1)"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Circle">
            <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ctrl|LineIcon#Play">
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="^:checked /template/ Border#Circle">
            <Setter Property="Background" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="^:checked /template/ ctrl|LineIcon#Play">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^:checked /template/ ctrl|LineIcon#Pause">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         DATE PICKER
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="ThemedDatePickerTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource PrimaryBlue}"/>
        <Setter Property="MinHeight"       Value="0"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <TextBlock Name="PART_Watermark" Text="{TemplateBinding Watermark}"
                               Foreground="{DynamicResource PlaceholderColor}"
                               FontSize="13" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                    <ScrollViewer Name="PART_ScrollViewer" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <TextPresenter Name="PART_TextPresenter"
                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                       CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="NoWrap"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                       CaretBrush="{TemplateBinding CaretBrush}"/>
                    </ScrollViewer>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="DatePickerDropButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="2">
                    <ctrl:LineIcon Data="{StaticResource Icon.Calendar}" Size="17"
                                   Foreground="{DynamicResource TextSecondary}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ThemedDatePicker" TargetType="CalendarDatePicker">
        <Setter Property="Background"      Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding"         Value="12,9"/>
        <Setter Property="MinHeight"       Value="40"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="IsTodayHighlighted" Value="True"/>
        <Setter Property="Watermark"       Value="yyyy-MM-dd"/>
        <!-- WPF DatePicker default: long date, e.g. "Saturday, October 24, 2026" -->
        <Setter Property="SelectedDateFormat" Value="Long"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                    <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="*,28" VerticalAlignment="Center">
                        <TextBox Grid.Column="0" Name="PART_TextBox"
                                 Theme="{StaticResource ThemedDatePickerTextBox}"
                                 Watermark="{TemplateBinding Watermark}"
                                 FontSize="{TemplateBinding FontSize}"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="PART_Button"
                                Theme="{StaticResource DatePickerDropButton}"
                                Focusable="False"
                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Popup Name="PART_Popup" Grid.ColumnSpan="2"
                               Placement="AnchorAndGravity" PlacementAnchor="BottomLeft" PlacementGravity="BottomRight"
                               WindowManagerAddShadowHint="False"
                               IsLightDismissEnabled="True">
                            <Calendar Name="PART_Calendar"
                                      FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                      IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                                      SelectedDate="{TemplateBinding SelectedDate, Mode=TwoWay}"
                                      DisplayDate="{TemplateBinding DisplayDate}"
                                      DisplayDateStart="{TemplateBinding DisplayDateStart}"
                                      DisplayDateEnd="{TemplateBinding DisplayDateEnd}"/>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:focus-within /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
        <Style Selector="^:pointerover:not(:focus-within) /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
        </Style>
    </ControlTheme>

    <!-- ── Calendar popup ─────────────────────────────────────────────── -->
    <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width"      Value="32"/>
        <Setter Property="Height"     Value="28"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="ClickMode"  Value="Release"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="0"
                        CornerRadius="4" Margin="1">
                    <ContentPresenter Name="Lbl" Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="12" FontWeight="Medium"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource TagBackground}"/>
        </Style>
        <Style Selector="^:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter#Lbl">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="^:today /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <!-- Inactive = adjacent month days — slightly dimmed but still readable -->
        <Style Selector="^:inactive /template/ ContentPresenter#Lbl">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="^:blackout /template/ ContentPresenter#Lbl">
            <Setter Property="Opacity" Value="0.25"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width"      Value="60"/>
        <Setter Property="Height"     Value="28"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="ClickMode"  Value="Release"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}" FontSize="12"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource TagBackground}"/>
        </Style>
    </ControlTheme>

    <!-- Calendar header: blue month title and arrows (arrows on a faint square), brighter on hover -->
    <ControlTheme x:Key="CalendarArrowButton" TargetType="Button">
        <Setter Property="Width"      Value="28"/>
        <Setter Property="Height"     Value="20"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBlue}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Rectangle Fill="#11E5EBF1" Stretch="Fill"/>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="CalendarHeaderButton" TargetType="Button">
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBlue}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      Margin="1,4,1,9"/>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">
        <Setter Property="DayTitleTemplate">
            <Template x:DataType="x:String">
                <TextBlock Text="{Binding}"
                           Foreground="{DynamicResource CalendarDayTitle}"
                           FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,5,0,5"/>
            </Template>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="1">
                    <Border BorderBrush="#FFFFFFFF" BorderThickness="2" CornerRadius="1">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,*">
                            <Button Name="PART_PreviousButton" Grid.Column="0" HorizontalAlignment="Left"
                                    Theme="{StaticResource CalendarArrowButton}">
                                <Path Data="M288.75,232.25 L288.75,240.625 L283,236.625 z"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Width="6" Height="10" Margin="14,-6,0,0" Stretch="Fill"/>
                            </Button>
                            <Button Name="PART_HeaderButton" Grid.Column="1"
                                    Theme="{StaticResource CalendarHeaderButton}"/>
                            <Button Name="PART_NextButton" Grid.Column="2" HorizontalAlignment="Right"
                                    Theme="{StaticResource CalendarArrowButton}">
                                <Path Data="M282.875,231.875 L282.875,240.375 L288.625,236 z"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Width="6" Height="10" Margin="0,-6,14,0" Stretch="Fill"/>
                            </Button>
                            <Grid Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" IsVisible="False"
                                  HorizontalAlignment="Center" Margin="6,-1,6,6"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"/>
                            <Grid Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" IsVisible="False"
                                  HorizontalAlignment="Center" Margin="6,-3,7,6"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,Auto,Auto,Auto"/>
                        </Grid>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="8" Padding="8">
                    <Border.Effect>
                        <DropShadowDirectionEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Color="#000"/>
                    </Border.Effect>
                    <StackPanel Name="PART_Root" HorizontalAlignment="Center" ClipToBounds="True">
                        <CalendarItem Name="PART_CalendarItem"
                                      Background="{DynamicResource CardBackground}"
                                      BorderBrush="Transparent"
                                      Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ── Filter Chips ───────────────────────────────────────────────── -->
    <ControlTheme x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Padding"    Value="14,5"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="999" Background="Transparent"
                        BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1"
                        Padding="{TemplateBinding Padding}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background"  Duration="0:0:0.18"/>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="^:checked /template/ Border#Bd">
            <Setter Property="Background"  Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
    </ControlTheme>

    <!-- One option inside a ctrl:SegmentedBar (the bar draws the sliding highlight) -->
    <ControlTheme x:Key="SegmentItem" TargetType="RadioButton">
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Padding"    Value="14,0"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment"   Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Style>
        <Style Selector="^:checked"><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Style>
    </ControlTheme>

    <!-- ── ScrollViewer: the bar sits in its own column, as on Windows ─── -->
    <!-- The wheel is handled by the ScrollContentPresenter, so it has a transparent Background to scroll
         over gaps between cards. Padding is a Margin: ScrollContentPresenter ignores its own Padding when
         sizing, which clipped the group chips and pushed dialog content past the right edge.
         Behaviors/ScrollPaddingWheel scrolls when the pointer is over that margin strip. -->
    <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="AllowAutoHide" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto"
                      Background="{TemplateBinding Background}">
                    <ScrollContentPresenter Name="PART_ContentPresenter"
                                            Grid.Row="0" Grid.Column="0"
                                            Background="Transparent"
                                            Margin="{TemplateBinding Padding}"
                                            ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}"
                                            HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                            VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                            HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                            VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}">
                        <ScrollContentPresenter.GestureRecognizers>
                            <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                                     CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                                     IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}"/>
                        </ScrollContentPresenter.GestureRecognizers>
                    </ScrollContentPresenter>
                    <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal"
                               Grid.Row="1" Grid.Column="0"/>
                    <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical"
                               Grid.Row="0" Grid.Column="1"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ── ScrollBar: thin 6px thumb, no arrow buttons ─────────────────── -->
    <ControlTheme x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{DynamicResource ChipBorder}" CornerRadius="3" Margin="1,0"/>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PrimaryBlue}"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Cursor" Value="Arrow"/>
        <Style Selector="^:vertical">
            <Setter Property="Width"    Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}"
                           IsDirectionReversed="True">
                        <Thumb Theme="{StaticResource ScrollThumb}"/>
                    </Track>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Horizontal bars were zero-height in the Windows design: scrolling still works, nothing is drawn -->
        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}">
                        <Thumb Theme="{StaticResource ScrollThumb}"/>
                    </Track>
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- ══════════════════════════════════════════════════════════════════
         CLASSIC CONTROLS — the stock Windows look of controls that the
         design leaves unstyled (buttons, text boxes, list boxes), so they
         render the same on every OS.
    ══════════════════════════════════════════════════════════════════ -->
    <ControlTheme x:Key="PlainButton" TargetType="Button">
        <Setter Property="Background"      Value="#FFDDDDDD"/>
        <Setter Property="BorderBrush"     Value="#FF707070"/>
        <Setter Property="Foreground"      Value="Black"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background"  Value="#FFBEE6FD"/>
            <Setter Property="BorderBrush" Value="#FF3C7FB1"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Bd">
            <Setter Property="Background"  Value="#FFC4E5F6"/>
            <Setter Property="BorderBrush" Value="#FF2C628B"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#Bd">
            <Setter Property="Background"  Value="#FFF4F4F4"/>
            <Setter Property="BorderBrush" Value="#FFADB2B5"/>
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground"  Value="#FF838383"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="PlainTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background"      Value="White"/>
        <Setter Property="BorderBrush"     Value="#FFABADB3"/>
        <Setter Property="Foreground"      Value="Black"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="MinHeight"       Value="0"/>
        <Setter Property="SelectionBrush"  Value="#3399FF"/>
        <Setter Property="SelectionForegroundBrush" Value="White"/>
        <Setter Property="CaretBrush"      Value="{Binding $self.Foreground}"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                        <TextPresenter Name="PART_TextPresenter"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                       CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="{TemplateBinding TextWrapping}"
                                       PasswordChar="{TemplateBinding PasswordChar}"
                                       RevealPassword="{TemplateBinding RevealPassword}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                       CaretBrush="{TemplateBinding CaretBrush}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Frame">
            <Setter Property="BorderBrush" Value="#FF7EB4EA"/>
        </Style>
        <Style Selector="^:focus /template/ Border#Frame">
            <Setter Property="BorderBrush" Value="#FF569DE5"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="PlainListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding"         Value="4,1"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background"  Value="#1F26A0DA"/>
            <Setter Property="BorderBrush" Value="#A826A0DA"/>
        </Style>
        <Style Selector="^:selected /template/ Border#Bd">
            <Setter Property="Background"  Value="#3D26A0DA"/>
            <Setter Property="BorderBrush" Value="#FF26A0DA"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="PlainListBox" TargetType="ListBox">
        <Setter Property="Background"      Value="White"/>
        <Setter Property="BorderBrush"     Value="#FFABADB3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="1"/>
        <Setter Property="ItemContainerTheme" Value="{StaticResource PlainListBoxItem}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Indeterminate bar: a highlight sweeping across a light track -->
    <ControlTheme x:Key="PlainProgressBar" TargetType="ProgressBar">
        <Setter Property="Background"  Value="#FFE6E6E6"/>
        <Setter Property="BorderBrush" Value="#FFBCBCBC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="4"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True">
                    <Panel>
                        <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left"/>
                        <Border Name="Sweep" Width="120" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" IsVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                        </Border>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^:indeterminate /template/ Border#Sweep">
            <Setter Property="IsVisible" Value="True"/>
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-120"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="560"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <!-- ── ToolTip: the classic white Windows tooltip ─────────────────── -->
    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Background"      Value="White"/>
        <Setter Property="BorderBrush"     Value="#FF767676"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="#FF575757"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="6,3"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ── Separator ──────────────────────────────────────────────────── -->
    <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="0,8"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"/>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
