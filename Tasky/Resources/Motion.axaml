<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Looping decorative motion. Off when the OS asks to reduce motion (the window gets .reduceMotion). -->

    <!-- Running timer: a soft ring pulses out of the play/pause button -->
    <Style Selector="Window:not(.reduceMotion) ToggleButton:checked /template/ Ellipse#Ring">
        <Style.Animations>
            <Animation Duration="0:0:1.8" IterationCount="Infinite" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1.7"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.7"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
