<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tasky.ViewModels"
        xmlns:models="using:Tasky.Models"
        xmlns:beh="using:Tasky.Behaviors"
        xmlns:ctrl="using:Tasky.Controls"
        xmlns:helpers="using:Tasky.Helpers"
        x:Class="Tasky.MainWindow"
        Title="Sysslar" Width="640" Height="720"
        MinWidth="444" MinHeight="421"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <!-- Sizes are the inside (client) area: the original 620×720 window minus the Windows frame -->

    <Window.Resources>
        <!-- Workspace switcher next to the logo, and the rows of its drop-down -->
        <ControlTheme x:Key="WorkspacePill" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.15"/></Transitions>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            </Style>
            <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.8"/></Style>
        </ControlTheme>
        <ControlTheme x:Key="WorkspaceMenuItem" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource IconHoverBackground}"/>
            </Style>
            <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.75"/></Style>
        </ControlTheme>
        <!-- "Empty Bin" text link in the sub-page header -->
        <ControlTheme x:Key="EmptyBinLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <TextBlock Name="EbTxt" Text="Empty Bin" FontSize="13" FontWeight="Medium"
                               Background="Transparent"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ TextBlock#EbTxt">
                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            </Style>
        </ControlTheme>

        <!-- Notifications / Upcoming Reminders tabs: icon in Tag, label in Content -->
        <ControlTheme x:Key="ReminderTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" BorderThickness="0,0,0,2"
                            BorderBrush="Transparent" Padding="0,12"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <ContentPresenter Content="{TemplateBinding Tag}" VerticalAlignment="Center"/>
                            <ContentPresenter Name="Lbl" Content="{TemplateBinding Content}"
                                              FontSize="13" FontWeight="SemiBold"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.15"/></Transitions>
            </Setter>
            <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Style>
            <Style Selector="^:checked"><Setter Property="Foreground" Value="{DynamicResource PrimaryBlue}"/></Style>
            <Style Selector="^:checked /template/ Border#Bd">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
            </Style>
        </ControlTheme>

        <!-- Recycle Bin entry on the Settings page: a whole card that is a button -->
        <ControlTheme x:Key="RecycleBinCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Theme="{StaticResource SectionCard}" Padding="16,12" Margin="0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ctrl:LineIcon Grid.Column="0" Data="{StaticResource Icon.Trash}" Size="20"
                                           Foreground="{DynamicResource IconMuted}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Recycle Bin" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="View and restore deleted tasks"
                                           Theme="{StaticResource SubText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ctrl:LineIcon Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Size="18"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- Description: two lines, or everything when expanded -->
        <!-- Two lines then "…" (a height limit: MaxLines cut the second line without the "…") -->
        <Style Selector="TextBlock.taskDescription">
            <Setter Property="MaxHeight"    Value="36"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.taskDescription.expanded">
            <Setter Property="MaxHeight"    Value="99999"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <!-- Running / paused timer on a task card -->
        <Style Selector="ctrl|LineIcon.timerIcon">
            <Setter Property="Data"       Value="{StaticResource Icon.Clock}"/>
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="ctrl|LineIcon.timerIcon.paused">
            <Setter Property="Data"       Value="{StaticResource Icon.Pause}"/>
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="TextBlock.timerText">
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="TextBlock.timerText.paused">
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="ctrl|LineIcon.pauseIcon">
            <Setter Property="Data" Value="{StaticResource Icon.Pause}"/>
        </Style>
        <Style Selector="ctrl|LineIcon.pauseIcon.paused">
            <Setter Property="Data" Value="{StaticResource Icon.Play}"/>
        </Style>

        <!-- Date / repeat tags on a card -->
        <Style Selector="Border.dueTag">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        </Style>
        <Style Selector="Border.dueTag > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="Border.dueTag.today">
            <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
        </Style>
        <Style Selector="Border.dueTag.today > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="Border.dueTag.overdue">
            <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
        </Style>
        <Style Selector="Border.dueTag.overdue > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>

        <!-- The description box shows no placeholder while it is disabled (no title yet) -->
        <Style Selector="TextBox#DescInputBox:disabled /template/ TextBlock#PART_Watermark">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Task cards: background brightens a little on hover, press in like a tile while the mouse button is down -->
        <Style Selector="Border.taskTile">
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
                    <BrushTransition Property="Background"  Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.taskTile.running">
            <Setter Property="Background"  Value="{DynamicResource CardRunning}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardRunningBorder}"/>
        </Style>
        <Style Selector="Border.taskTile:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        </Style>
        <Style Selector="Border.taskTile.running:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardRunningHover}"/>
        </Style>
        <Style Selector="Border.taskTile.pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- Just saved on the Edit Task page: the border flashes in the accent colour -->
        <Style Selector="Border.taskTile.justEdited">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
        </Style>

        <!-- The task picked with the arrow keys (keyboard shortcuts act on it) -->
        <Style Selector="Border.selectedTask, Border.selectedTask:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
        </Style>

        <!-- The workspace drop-down and the card ⋯ menu draw their own card, so the flyout itself is bare -->
        <Style Selector="FlyoutPresenter.workspaceMenu">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="MinWidth"        Value="0"/>
        </Style>

        <!-- Narrow window: card actions fold into the ⋯ menu, and the view switch gets its own row -->
        <Style Selector="StackPanel.cardActions">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Button.cardMore">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid#RootGrid.compact StackPanel.cardActions">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid#RootGrid.compact Button.cardMore">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ctrl|SegmentedBar#FilterBar">
            <Setter Property="Grid.Column"         Value="1"/>
            <Setter Property="Margin"              Value="12,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- Narrow: the view switch stays on the toolbar row and shrinks to fit -->
        <Style Selector="Grid#RootGrid.compact ctrl|SegmentedBar#FilterBar">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin"              Value="10,0,0,0"/>
        </Style>
        <Style Selector="Grid#RootGrid.compact ctrl|SegmentedBar#FilterBar > RadioButton">
            <Setter Property="Padding"  Value="4,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="Button#AddToggleBtn">
            <Setter Property="Padding" Value="16,9"/>
        </Style>
        <Style Selector="Grid#RootGrid.compact Button#AddToggleBtn">
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <!-- Stats: 4 tiles in a row, 2×2 when narrow; card filters under the title; charts stacked -->
        <Style Selector="UniformGrid.statTiles"><Setter Property="Columns" Value="4"/></Style>
        <Style Selector="Grid#RootGrid.compact UniformGrid.statTiles"><Setter Property="Columns" Value="2"/></Style>
        <Style Selector="WrapPanel.headerChips">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin"      Value="12,0,0,0"/>
        </Style>
        <Style Selector="Grid#RootGrid.compact WrapPanel.headerChips">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row"    Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin"      Value="0,10,0,0"/>
        </Style>
        <Style Selector="StackPanel.firstChart"><Setter Property="Grid.Column" Value="0"/></Style>
        <Style Selector="StackPanel.secondChart"><Setter Property="Grid.Column" Value="2"/></Style>
        <Style Selector="Grid#RootGrid.compact StackPanel.firstChart"><Setter Property="Grid.ColumnSpan" Value="3"/></Style>
        <Style Selector="Grid#RootGrid.compact StackPanel.secondChart">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row"    Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="Margin"      Value="0,16,0,0"/>
        </Style>

        <!-- Settings: Profile and Appearance side by side, stacked when narrow -->
        <Style Selector=":is(Control).appLabel, :is(Control).appCard"><Setter Property="Grid.Column" Value="2"/></Style>
        <Style Selector=":is(Control).profCard, :is(Control).appCard"><Setter Property="Grid.Row" Value="1"/></Style>
        <Style Selector="Grid#RootGrid.compact :is(Control).settingsPair"><Setter Property="Grid.ColumnSpan" Value="3"/></Style>
        <Style Selector="Grid#RootGrid.compact :is(Control).appLabel">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row"    Value="2"/>
            <Setter Property="Margin"      Value="0,16,0,6"/>
        </Style>
        <Style Selector="Grid#RootGrid.compact :is(Control).appCard">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row"    Value="3"/>
        </Style>

        <!-- Settings rows: icon tile · title · one line · action, separated by thin dividers -->
        <Style Selector=":is(Panel).settingsRow"><Setter Property="Margin" Value="16,12"/></Style>
        <Style Selector="Border.iconTile">
            <Setter Property="Width"        Value="36"/>
            <Setter Property="Height"       Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background"   Value="{DynamicResource AccentSoft}"/>
            <Setter Property="Margin"       Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.iconTile > ctrl|LineIcon">
            <Setter Property="Foreground"          Value="{DynamicResource PrimaryBlue}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
        <Style Selector="StackPanel.rowText">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,12,0"/>
        </Style>
        <Style Selector="TextBlock.rowTitle">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.rowSub">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin"       Value="0,2,0,0"/>
        </Style>
        <Style Selector="Border.rowDivider">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Margin"     Value="64,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding"  Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Grid#RootGrid.narrow TextBlock#BrandText">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <!-- Zooms everything for Settings → Text size -->
    <LayoutTransformControl x:Name="ZoomHost">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MAIN HEADER: logo · name · workspace on the left, page icons on the right, a divider below -->
        <Border x:Name="MainHeader" Grid.Row="0" Padding="16,12,16,0">
            <StackPanel>
            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10"
                                ClipToBounds="True">
                        <Image Source="/Assets/sysslar-logo.png" Width="34" Height="34"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="BrandText" Text="Sysslar" Theme="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                        <!-- Workspace switcher: each workspace (e.g. Personal, Office) has completely separate data -->
                        <Button x:Name="WorkspaceButton" Theme="{StaticResource WorkspacePill}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Switch workspace" Click="WorkspaceButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="WorkspaceDot" Width="8" Height="8" Fill="{DynamicResource PrimaryBlue}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="WorkspaceNameText" FontSize="13" FontWeight="Medium"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <ctrl:LineIcon Data="{StaticResource Icon.ChevronDown}" Size="14"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2"
                                Margin="8,0,0,0">
                        <Button Theme="{StaticResource IconButton}" Classes="remind" ToolTip.Tip="Reminders &amp; Notifications"
                                Click="Reminders_Click">
                            <Panel>
                                <ctrl:LineIcon Data="{StaticResource Icon.Bell}" Size="20"/>
                                <Border x:Name="NotifBadge"
                                        Background="{DynamicResource Danger}" CornerRadius="8"
                                        MinWidth="16" Height="16"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-6,-6,0" Padding="4,0"
                                        BorderBrush="{DynamicResource AppBackground}" BorderThickness="1.5"
                                        RenderTransformOrigin="50%,50%"
                                        IsVisible="{Binding HasMissedNotifs}">
                                    <TextBlock x:Name="NotifBadgeText"
                                               Text="{Binding MissedNotifCount}"
                                               FontSize="9" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Panel>
                        </Button>
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Notes" Click="Notes_Click">
                            <ctrl:LineIcon Data="{StaticResource Icon.Note}" Size="20"/>
                        </Button>
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Manage Groups" Click="Groups_Click">
                            <ctrl:LineIcon Data="{StaticResource Icon.Folder}" Size="20"/>
                        </Button>
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Stats &amp; Reports" Click="Stats_Click">
                            <ctrl:LineIcon Data="{StaticResource Icon.Chart}" Size="20"/>
                        </Button>
                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Settings" Click="Settings_Click">
                            <ctrl:LineIcon Data="{StaticResource Icon.Gear}" Size="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Sync needs the user (only when it does): a changed key, or the folder gone for a while -->
            <Border x:Name="SyncBanner" IsVisible="False" Margin="0,10,0,0"
                    Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Warning}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ctrl:LineIcon Data="{StaticResource Icon.Refresh}" Size="16" Foreground="{DynamicResource Warning}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="SyncBannerText" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button x:Name="SyncBannerButton" Grid.Column="2" Theme="{StaticResource PrimaryButton}" Classes="small"
                            Margin="10,0,0,0" Content="Enter new key" Click="Sync_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
        </Border>

        <!-- SUB-PAGE HEADER: Back · title · page actions, a divider below -->
        <Border x:Name="SubHeader" Grid.Row="0" IsVisible="False" Padding="16,12,16,0">
            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Theme="{StaticResource GhostButton}" Click="Back_Click" Margin="-8,0,8,0"
                            ToolTip.Tip="Back (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ctrl:LineIcon Data="{StaticResource Icon.ChevronLeft}" Size="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" x:Name="SubPageTitle"
                               FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <!-- New Note: only visible on the Notes page -->
                        <Button x:Name="NewNoteBtn" Theme="{StaticResource PrimaryButton}"
                                Padding="14,7" IsVisible="False" Click="NewNote_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctrl:LineIcon Data="{StaticResource Icon.Plus}" Size="16" StrokeThickness="2.2" VerticalAlignment="Center"/>
                                <TextBlock Text="New Note" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Empty Bin: only visible on the Recycle Bin page -->
                        <Button x:Name="EmptyBinBtn" Click="EmptyBin_Click"
                                Theme="{StaticResource EmptyBinLink}"
                                IsVisible="False" ToolTip.Tip="Permanently delete all items in the bin"/>
                        <Button Theme="{StaticResource IconButton}" Click="ThemeToggle_Click"
                                ToolTip.Tip="Switch between dark and light">
                            <ctrl:LineIcon x:Name="SubThemeIcon" Data="{StaticResource Icon.Moon}" Size="19"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- TOOLBAR + ADD FORM -->
        <Border x:Name="AddPanelBorder" Grid.Row="1" Padding="16,16,16,0">
            <StackPanel>
                <Grid x:Name="ToolbarGrid" ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" x:Name="AddToggleBtn" VerticalAlignment="Center"
                            Theme="{StaticResource PrimaryButton}" Click="AddToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:LineIcon x:Name="AddToggleIcon" Data="{StaticResource Icon.Plus}" Size="16" StrokeThickness="2.2"
                                           VerticalAlignment="Center"/>
                            <TextBlock x:Name="AddToggleText" Text="New Task" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ctrl:SegmentedBar x:Name="FilterBar" Height="44"
                                       TrackBrush="{DynamicResource InputBackground}"
                                       HighlightBrush="{DynamicResource PrimaryBlue}">
                        <RadioButton Theme="{StaticResource SegmentItem}" Content="All"
                                     IsChecked="{Binding FilterAll, Mode=OneWay}"
                                     Click="Filter_All_Click" GroupName="TF"/>
                        <RadioButton Theme="{StaticResource SegmentItem}" Content="Today"
                                     IsChecked="{Binding FilterToday, Mode=OneWay}"
                                     Click="Filter_Today_Click" GroupName="TF"/>
                        <RadioButton Theme="{StaticResource SegmentItem}" Content="This Week"
                                     IsChecked="{Binding FilterThisWeek, Mode=OneWay}"
                                     Click="Filter_ThisWeek_Click" GroupName="TF"/>
                    </ctrl:SegmentedBar>
                    <Button Grid.Column="2" Theme="{StaticResource IconButton}" Classes="timer"
                            ToolTip.Tip="Completed Tasks" Click="Completed_Click"
                            VerticalAlignment="Center" Margin="6,0,0,0">
                        <ctrl:LineIcon Data="{StaticResource Icon.Done}" Size="20"/>
                    </Button>
                </Grid>

                <!-- Add form -->
                <Border x:Name="AddFormPanel" IsVisible="False" Theme="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel Spacing="12">
                        <!-- Title — full width -->
                        <TextBox x:Name="TitleInputBox"
                                 Theme="{StaticResource InputBox}" Watermark="Task title..."
                                 FontSize="15" FontWeight="Medium"
                                 Text="{Binding NewTitle}"
                                 KeyDown="TitleBox_KeyDown"/>

                        <!-- Description -->
                        <Grid>
                            <TextBox x:Name="DescInputBox"
                                     Theme="{StaticResource InputBox}"
                                     Watermark="Description (optional)..."
                                     Text="{Binding NewDescription}"
                                     IsEnabled="{Binding HasTitle}"
                                     MinHeight="64" MaxHeight="120" TextWrapping="Wrap"
                                     AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            <Border IsHitTestVisible="False" CornerRadius="12"
                                    Background="{DynamicResource InputBackground}"
                                    IsVisible="{Binding !HasTitle}">
                                <TextBlock Text="Enter a title first..." Foreground="{DynamicResource PlaceholderColor}"
                                           FontSize="13" FontStyle="Italic"
                                           VerticalAlignment="Top" Margin="14,11"/>
                            </Border>
                        </Grid>

                        <!-- Attachments: saved with the task when it is added -->
                        <ctrl:PendingAttachmentsPanel x:Name="NewTaskAttachments"/>

                        <!-- Start / Group / Repeat / Ends on: wrap onto more lines when narrow -->
                        <WrapPanel Classes="formFields" ItemSpacing="12" LineSpacing="12">
                            <StackPanel Width="160">
                                <TextBlock Text="START" Theme="{StaticResource LabelText}"/>
                                <CalendarDatePicker Theme="{StaticResource ThemedDatePicker}"
                                                    SelectedDate="{Binding NewDueDate, Mode=TwoWay}"
                                                    SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd"
                                                    FirstDayOfWeek="Monday"/>
                            </StackPanel>
                            <StackPanel Width="150">
                                <TextBlock Text="GROUP" Theme="{StaticResource LabelText}"/>
                                <ComboBox x:Name="NewTaskGroupPicker" Theme="{StaticResource ThemedComboBox}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="NewTaskGroup_Changed"/>
                            </StackPanel>
                            <StackPanel Width="140">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="REPEAT" Theme="{StaticResource LabelText}"/>
                                    <ctrl:LineIcon Data="{StaticResource Icon.Info}" Size="13"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="6,0,0,6" VerticalAlignment="Center" Cursor="Help"
                                                   ToolTip.ShowDelay="0"
                                                   ToolTip.Tip="{x:Static helpers:RecurrenceRules.Explanation}"/>
                                </StackPanel>
                                <ComboBox x:Name="NewTaskRecurrencePicker" Theme="{StaticResource ThemedComboBox}"
                                          HorizontalAlignment="Stretch" SelectedIndex="0"
                                          SelectionChanged="NewTaskRecurrence_Changed">
                                    <ComboBoxItem Content="None"    Tag="0"/>
                                    <ComboBoxItem Content="Daily"   Tag="1"/>
                                    <ComboBoxItem Content="Weekly"  Tag="2"/>
                                    <ComboBoxItem Content="Monthly" Tag="3"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="160" IsVisible="{Binding NewTaskRepeats}">
                                <TextBlock Text="ENDS ON" Theme="{StaticResource LabelText}"/>
                                <CalendarDatePicker Theme="{StaticResource ThemedDatePicker}"
                                                    SelectedDate="{Binding NewTaskRecurrenceEndDate, Mode=TwoWay}"
                                                    SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd"
                                                    FirstDayOfWeek="Monday" Watermark="No end date"/>
                            </StackPanel>
                        </WrapPanel>

                        <Button HorizontalAlignment="Right"
                                Theme="{StaticResource PrimaryButton}"
                                Command="{Binding AddTaskCommand}"
                                Content="Add Task" Click="AddTask_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- PAGE CONTAINER -->
        <Grid x:Name="PageContainer" Grid.Row="2">

            <!-- PAGE 1: Task list -->
            <Grid x:Name="TaskListPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Group filter chips -->
                <ScrollViewer x:Name="GroupFilterScroll" Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Padding="16,14,16,0" IsVisible="False">
                    <StackPanel x:Name="GroupChipsPanel" Orientation="Horizontal" Spacing="8"/>
                </ScrollViewer>

                <!-- Task search bar -->
                <Border Grid.Row="1" Padding="16,14,16,2">
                    <TextBox x:Name="TaskSearchBox"
                             Theme="{StaticResource InputBox}" Watermark="Search tasks..."
                             VerticalContentAlignment="Center" Padding="10,12"
                             Text="{Binding TaskSearch}">
                        <TextBox.InnerLeftContent>
                            <ctrl:LineIcon Data="{StaticResource Icon.Search}" Size="18"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>
                </Border>

                <!-- Empty state — shown when VisibleTasks is empty -->
                <StackPanel Grid.Row="2" Spacing="12"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsVisible="{Binding !HasVisibleTasks}"
                            IsHitTestVisible="False">
                    <ctrl:LineIcon Data="{StaticResource Icon.Done}" Size="48" StrokeThickness="1.4"
                                   Foreground="{DynamicResource PlaceholderColor}" Opacity="0.6"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyTasksMessage}"
                               FontSize="14" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="24,0"/>
                </StackPanel>

                <!-- Vertical space is a margin inside the scrolled content, not ScrollViewer padding:
                     padding sits outside the clip, so a card lifted on hover would lose its top edge -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto" Padding="16,0">
                    <ItemsControl x:Name="TaskListControl" Margin="0,12"
                                  ItemsSource="{Binding VisibleTasks}"
                                  beh:DragDropBehavior.IsEnabled="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TaskItemViewModel">
                                <!-- Click anywhere on the card (except its buttons) to edit the task -->
                                <Border Theme="{StaticResource TaskCard}"
                                        Classes="taskTile"
                                        Classes.running="{Binding IsActive}"
                                        Classes.selectedTask="{Binding IsSelected}"
                                        Padding="0" Cursor="Hand"
                                        PointerPressed="TaskCard_PointerPressed"
                                        PointerReleased="TaskCard_PointerReleased"
                                        PointerCaptureLost="TaskCard_PointerCaptureLost"
                                        PointerExited="TaskCard_PointerExited">
                                    <Grid>
                                        <!-- Group colour strip on the left edge -->
                                        <Border Width="3" HorizontalAlignment="Left" Margin="-1,14,0,14"
                                                CornerRadius="0,3,3,0"
                                                IsVisible="{Binding GroupBadge, Converter={StaticResource HasText}}"
                                                Background="{Binding GroupBrush}"
                                                ToolTip.Tip="{Binding GroupBadge}"/>

                                        <Grid Margin="16,14,10,14" ColumnDefinitions="Auto,Auto,*,Auto">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                      Theme="{StaticResource CheckmarkBox}"
                                                      VerticalAlignment="Top" Margin="0,2,12,0"
                                                      ToolTip.Tip="Mark as done"
                                                      Click="Checkbox_Click"/>
                                            <ToggleButton Grid.Column="1" Theme="{StaticResource TimerPlayButton}"
                                                          IsChecked="{Binding IsActive, Mode=OneWay}"
                                                          Click="ActiveToggle_Click"
                                                          ToolTip.Tip="{Binding IsActive, Converter={x:Static helpers:TimerTips.Converter}}"
                                                          VerticalAlignment="Top" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,3,8,0">
                                                <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                    <TextBlock Text="{Binding TaskNumberDisplay}"
                                                               FontSize="14" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryBlue}"/>
                                                    <!-- Start date tag -->
                                                    <Border Theme="{StaticResource Tag}" Classes="dueTag"
                                                            Classes.today="{Binding IsDueToday}"
                                                            Classes.overdue="{Binding IsOverdue}"
                                                            IsVisible="{Binding DueDateTag, Converter={StaticResource HasText}}">
                                                        <TextBlock Text="{Binding DueDateTag}" FontSize="12" FontWeight="Medium"/>
                                                    </Border>
                                                    <!-- Recurrence tag -->
                                                    <Border Theme="{StaticResource Tag}" Classes="dueTag"
                                                            IsVisible="{Binding RecurrenceDisplay, Converter={StaticResource HasText}}"
                                                            ToolTip.Tip="{Binding RecurrenceTooltip}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <ctrl:LineIcon Data="{StaticResource Icon.Repeat}" Size="12"
                                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding RecurrenceDisplay}" FontSize="12" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Attachment / reminder counts: small chips in the tag row, so they cost no space -->
                                                    <Border Theme="{StaticResource Tag}" Classes="dueTag"
                                                            IsVisible="{Binding HasAttachments}"
                                                            ToolTip.Tip="{Binding AttachmentCountDisplay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <ctrl:LineIcon Data="{StaticResource Icon.Clip}" Size="12"
                                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AttachmentCount}" FontSize="12" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Theme="{StaticResource Tag}" Classes="dueTag"
                                                            IsVisible="{Binding HasReminders}"
                                                            ToolTip.Tip="{Binding ReminderCountDisplay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <ctrl:LineIcon Data="{StaticResource Icon.Bell}" Size="12"
                                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ReminderCount}" FontSize="12" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="15" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </WrapPanel>
                                                <StackPanel IsVisible="{Binding Description, Converter={StaticResource HasText}}"
                                                            Margin="0,6,0,0">
                                                    <TextBlock x:Name="TaskDescriptionText"
                                                               Text="{Binding Description}" TextWrapping="Wrap"
                                                               FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                                               Classes="taskDescription"
                                                               Classes.expanded="{Binding IsDescriptionExpanded}"
                                                               beh:TextOverflow.Detect="True"/>
                                                    <!-- Only when the description is cut off, or to collapse it again -->
                                                    <Button Content="{Binding ShowMoreLabel}" HorizontalAlignment="Left"
                                                            Theme="{StaticResource BareButton}"
                                                            Click="ShowMore_Click"
                                                            Padding="0,4,0,0"
                                                            Foreground="{DynamicResource PrimaryBlue}"
                                                            FontSize="12" FontWeight="Medium">
                                                        <Button.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                                <Binding Path="IsDescriptionExpanded"/>
                                                                <CompiledBinding Path="#TaskDescriptionText.(beh:TextOverflow.IsTrimmed)"/>
                                                            </MultiBinding>
                                                        </Button.IsVisible>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="6"
                                                            IsVisible="{Binding IsActive}">
                                                    <ctrl:LineIcon Size="14" VerticalAlignment="Center"
                                                                   Classes="timerIcon" Classes.paused="{Binding IsPaused}"/>
                                                    <TextBlock Text="{Binding ElapsedDisplay}" VerticalAlignment="Center"
                                                               FontSize="12" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                                               Classes="timerText" Classes.paused="{Binding IsPaused}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Right column: the actions (or ⋯ when narrow) -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Top">
                                            <!-- Actions: grey, coloured on hover -->
                                            <StackPanel Classes="cardActions" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                                <Button Theme="{StaticResource IconButton}" Classes="timer" ToolTip.Tip="Pause / Resume"
                                                        Click="Pause_Click" IsVisible="{Binding IsActive}">
                                                    <ctrl:LineIcon Classes="pauseIcon" Classes.paused="{Binding IsPaused}"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" Classes="attach" ToolTip.Tip="Attachments"
                                                        Click="Attachment_Click">
                                                    <ctrl:LineIcon Data="{StaticResource Icon.Clip}"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" Classes="postpone" ToolTip.Tip="Postpone"
                                                        Click="Postpone_Click">
                                                    <ctrl:LineIcon Data="{StaticResource Icon.Skip}"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" Classes="edit" ToolTip.Tip="Edit"
                                                        Click="Edit_Click">
                                                    <ctrl:LineIcon Data="{StaticResource Icon.Edit}"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" Classes="remind" ToolTip.Tip="Set reminder"
                                                        Click="Reminder_Click">
                                                    <ctrl:LineIcon Data="{StaticResource Icon.Bell}"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" Classes="delete" ToolTip.Tip="Delete"
                                                        Click="Delete_Click">
                                                    <ctrl:LineIcon Data="{StaticResource Icon.Trash}"/>
                                                </Button>
                                            </StackPanel>
                                            <!-- Narrow window: the same actions behind ⋯ -->
                                            <Button Theme="{StaticResource IconButton}" Classes="cardMore" HorizontalAlignment="Right" ToolTip.Tip="Actions"
                                                    Click="CardMore_Click">
                                                <ctrl:LineIcon Data="{StaticResource Icon.Dots}" IsFilled="True"/>
                                            </Button>

                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid><!-- end TaskListPage wrapper -->

            <!-- PAGE 2: Completed Tasks -->
            <!-- Edit Task page (Views/EditTaskPage), created when a task is opened -->
            <Panel x:Name="EditTaskPageHost" IsVisible="False"/>

            <!-- Note page (Views/NotePage), created when a note is opened -->
            <Panel x:Name="NotePageHost" IsVisible="False"/>

            <Grid x:Name="CompletedPage" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="16,12,16,0">
                    <!-- Filters, date and sort wrap onto more lines when the window is narrow -->
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <RadioButton x:Name="CChipAll"  Theme="{StaticResource FilterChip}" Content="All"
                                         Tag="All" IsChecked="True" GroupName="CF"
                                         Click="CGroup_Click"/>
                        <RadioButton x:Name="CChipToday" Theme="{StaticResource FilterChip}" Content="Today"
                                         Tag="Today" GroupName="CF" Click="CGroup_Click"/>
                        <RadioButton x:Name="CChipWeek"  Theme="{StaticResource FilterChip}" Content="This Week"
                                         Tag="This Week" GroupName="CF" Click="CGroup_Click"/>
                        <RadioButton x:Name="CChipMonth" Theme="{StaticResource FilterChip}" Content="This Month"
                                         Tag="This Month" GroupName="CF" Click="CGroup_Click"/>
                        <CalendarDatePicker x:Name="CompletedDatePicker"
                                                Theme="{StaticResource ThemedDatePicker}"
                                                Width="150" FontSize="13"
                                                SelectedDateChanged="CompletedDate_Changed"
                                                ToolTip.Tip="Filter by specific date"/>
                        <ComboBox x:Name="SortBox"
                                  Theme="{StaticResource ThemedComboBox}" Width="170" FontSize="13"
                                  SelectedIndex="0"
                                  SelectionChanged="Sort_Changed">
                            <ComboBoxItem Content="Newest first"      Tag="newest"/>
                            <ComboBoxItem Content="Oldest first"      Tag="oldest"/>
                            <ComboBoxItem Content="Most time spent"   Tag="time_desc"/>
                            <ComboBoxItem Content="Least time spent"  Tag="time_asc"/>
                        </ComboBox>
                    </WrapPanel>
                </Border>
                <!-- Completed search -->
                <Border Grid.Row="1" Padding="16,12,16,0">
                    <TextBox Theme="{StaticResource InputBox}" Watermark="Search completed tasks..."
                             VerticalContentAlignment="Center" Padding="10,11"
                             Text="{Binding CompletedSearch}">
                        <TextBox.InnerLeftContent><ctrl:LineIcon Data="{StaticResource Icon.Search}" Size="18"/></TextBox.InnerLeftContent>
                    </TextBox>
                </Border>
                <!-- Empty state for completed list -->
                <StackPanel x:Name="CompletedEmptyState" Grid.Row="2"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsVisible="False" IsHitTestVisible="False">
                    <ctrl:LineIcon Data="{StaticResource Icon.Done}" Size="48" StrokeThickness="1.4"
                                   Foreground="{DynamicResource PlaceholderColor}" Opacity="0.6"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No completed tasks to show."
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Opacity="0.6"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <ItemsControl x:Name="CompletedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TaskItemViewModel">
                                <Border Theme="{StaticResource TaskCard}" Margin="0,0,0,8" Cursor="Hand"
                                        PointerReleased="CompletedTask_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding TaskNumberDisplay}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBlue}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CompletedAtDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource AccentGreen}"
                                                           FontFamily="{StaticResource MonoFont}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Theme="{StaticResource IconButton}" Classes="postpone"
                                                    ToolTip.Tip="Resume task (mark as incomplete)"
                                                    Click="Completed_Uncheck"
                                                    Margin="0,0,2,0">
                                                <ctrl:LineIcon Data="{StaticResource Icon.Undo}"/>
                                            </Button>
                                            <Button Theme="{StaticResource IconButton}" Classes="attach"
                                                    ToolTip.Tip="Update time spent"
                                                    Click="CompletedUpdateTime_Click"
                                                    Margin="0,0,2,0">
                                                <ctrl:LineIcon Data="{StaticResource Icon.Timer}"/>
                                            </Button>
                                            <Button Theme="{StaticResource IconButton}" Classes="delete"
                                                    ToolTip.Tip="Delete"
                                                    Click="CompletedDelete_Click">
                                                <ctrl:LineIcon Data="{StaticResource Icon.Trash}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 3: Notes -->
            <Grid x:Name="NotesPage" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Add note panel -->
                <Border x:Name="AddNotePanel" Grid.Row="0"
                        IsVisible="False"
                        Padding="16,12,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" x:Name="NoteTitleBox" Theme="{StaticResource InputBox}"
                                 Watermark="Note title..." Text="{Binding NewNoteTitle}"/>
                        <TextBox Grid.Row="2" x:Name="NoteDescBox" Theme="{StaticResource InputBox}"
                                 Watermark="Note content (optional)..."
                                 Text="{Binding NewNoteDescription}"
                                 MinHeight="60" MaxHeight="120" TextWrapping="Wrap"
                                 AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                        <TextBox Grid.Row="4" x:Name="NoteTagsBox" Theme="{StaticResource InputBox}"
                                 Watermark="Search terms / tags (comma-separated)..."/>
                        <!-- Attachments: saved with the note when it is added -->
                        <ctrl:PendingAttachmentsPanel x:Name="NewNoteAttachments" Grid.Row="6"/>
                        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Theme="{StaticResource SecondaryButton}"
                                    Content="Cancel" Margin="0,0,8,0"
                                    Click="CancelNote_Click"/>
                            <Button Theme="{StaticResource PrimaryButton}"
                                    Content="Add Note" Click="SaveNote_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Search -->
                <Border Grid.Row="1" Padding="16,12,16,0">
                    <TextBox Theme="{StaticResource InputBox}" Watermark="Search notes..."
                             VerticalContentAlignment="Center" Padding="10,11"
                             Text="{Binding NoteSearch}">
                        <TextBox.InnerLeftContent><ctrl:LineIcon Data="{StaticResource Icon.Search}" Size="18"/></TextBox.InnerLeftContent>
                    </TextBox>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="NotesEmptyLabel" Text="No notes yet."
                                   Theme="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,24,0,0"
                                   IsVisible="False"/>
                        <ItemsControl x:Name="NotesList" ItemsSource="{Binding FilteredNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:Note">
                                    <Border Theme="{StaticResource TaskCard}" Margin="0,0,0,8"
                                            Cursor="Hand" PointerReleased="Note_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="NoteDescriptionText"
                                                           Text="{Binding Description}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="36"
                                                           beh:TextOverflow.Detect="True"/>
                                                <!-- "There's more": open the note to read all of it -->
                                                <ctrl:LineIcon Data="{StaticResource Icon.Dots}" IsFilled="True" Size="16" HorizontalAlignment="Left"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           ToolTip.Tip="Open the note to see all of it"
                                                           IsVisible="{CompiledBinding #NoteDescriptionText.(beh:TextOverflow.IsTrimmed)}"/>
                                                <!-- Tag chips (only rendered when there are tags) -->
                                                <ItemsControl ItemsSource="{Binding TagList}" Margin="0,5,0,0"
                                                              IsVisible="{Binding Tags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource PrimaryBlue}"
                                                                    BorderThickness="1" CornerRadius="999"
                                                                    Padding="8,2" Margin="0,0,6,4">
                                                                <TextBlock Text="{Binding}" FontSize="11"
                                                                           Foreground="{DynamicResource PrimaryBlue}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Attachment count (only when the note has files) -->
                                                <TextBlock IsVisible="{Binding HasAttachments}"
                                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                           Margin="0,5,0,0">
                                                    <InlineUIContainer BaselineAlignment="Center"><ctrl:LineIcon Data="{StaticResource Icon.Clip}" Size="13" Margin="0,0,4,0"/></InlineUIContainer>
                                                    <Run Text="{Binding AttachmentCountDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Theme="{StaticResource IconButton}" Classes="delete"
                                                    ToolTip.Tip="Delete note"
                                                    VerticalAlignment="Center" Click="DeleteNote_Click">
                                                <ctrl:LineIcon Data="{StaticResource Icon.Trash}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 4: Stats -->
            <Grid x:Name="StatsPage" IsVisible="False">
                <ScrollViewer x:Name="StatsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <!-- Summary cards row -->
                        <UniformGrid x:Name="StatTiles" Classes="statTiles" Margin="-4,-4,-4,12">
                            <Border Theme="{StaticResource SectionCard}" Padding="14,12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="TODAY" Theme="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="StatTodayCount" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBlue}" Text="0"/>
                                    <TextBlock Text="completed" Theme="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                            <Border Theme="{StaticResource SectionCard}" Padding="14,12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="THIS WEEK" Theme="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="StatWeekCount" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentGreen}" Text="0"/>
                                    <TextBlock Text="completed" Theme="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                            <Border Theme="{StaticResource SectionCard}" Padding="14,12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="TODAY TIME" Theme="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="StatTimeToday" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Warning}" FontFamily="{StaticResource MonoFont}" Text="0m"/>
                                    <TextBlock Text="tracked" Theme="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                            <Border Theme="{StaticResource SectionCard}" Padding="14,12" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="ALL TIME" Theme="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="StatAllTime" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource IconEditHover}" FontFamily="{StaticResource MonoFont}" Text="0m"/>
                                    <TextBlock Text="tracked" Theme="{StaticResource SubText}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Meeting Hours (auto-detected: meeting app + mic/camera) -->
                        <Border x:Name="MeetingHoursCard" Theme="{StaticResource SectionCard}" Padding="16,14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Classes="cardHeader" Margin="0,0,0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="Meeting Hours" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <WrapPanel Classes="headerChips" ItemSpacing="4" LineSpacing="4">
                                        <RadioButton x:Name="MeetingFilterToday" GroupName="MeetingFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Today"
                                                     Tag="today" Click="MeetingFilter_Click"/>
                                        <RadioButton x:Name="MeetingFilterWeek" GroupName="MeetingFilter"
                                                     Theme="{StaticResource FilterChip}" Content="This Week"
                                                     Tag="week" IsChecked="True"
                                                     Click="MeetingFilter_Click"/>
                                        <RadioButton x:Name="MeetingFilterMonth" GroupName="MeetingFilter"
                                                     Theme="{StaticResource FilterChip}" Content="This Month"
                                                     Tag="month" Click="MeetingFilter_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock x:Name="StatMeetingDisplay"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource Success}" FontFamily="{StaticResource MonoFont}" Text="—"/>
                                <TextBlock Text="meeting app + mic/camera detected"
                                           Theme="{StaticResource SubText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Last 7 Days — task count + time spent, with week navigation -->
                        <Border Theme="{StaticResource SectionCard}" Padding="16,14" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Header with week navigation -->
                                <Grid Classes="cardHeader" Margin="0,0,0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="Last 7 Days" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PrevWeekBtn" Theme="{StaticResource IconButton}"
                                                Click="PrevWeek_Click" ToolTip.Tip="Previous week">
                                            <ctrl:LineIcon Data="{StaticResource Icon.ChevronLeft}"/>
                                        </Button>
                                        <TextBlock x:Name="WeekLabel" Text="" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                        <Button x:Name="NextWeekBtn" Theme="{StaticResource IconButton}"
                                                Click="NextWeek_Click" ToolTip.Tip="Next week" IsEnabled="False">
                                            <ctrl:LineIcon Data="{StaticResource Icon.ChevronRight}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- Two charts side by side -->
                                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
                                    <StackPanel Classes="firstChart">
                                        <TextBlock Text="Tasks completed" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <UniformGrid x:Name="BarChartPanel" Rows="1"
                                                    VerticalAlignment="Bottom" MinHeight="80"/>
                                    </StackPanel>
                                    <StackPanel Classes="secondChart">
                                        <TextBlock Text="Time spent" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <UniformGrid x:Name="TimeChartPanel" Rows="1"
                                                    VerticalAlignment="Bottom" MinHeight="80"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Top tasks -->
                        <Border Theme="{StaticResource SectionCard}" Padding="16,14">
                            <StackPanel>
                                <Grid Classes="cardHeader" Margin="0,0,0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="Most Time Spent" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <WrapPanel Classes="headerChips" ItemSpacing="4" LineSpacing="4">
                                        <RadioButton x:Name="TopToday"   GroupName="TopFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Today"
                                                     Tag="today"   Click="TopFilter_Click"/>
                                        <RadioButton x:Name="TopWeek"    GroupName="TopFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Week"
                                                     Tag="week"    Click="TopFilter_Click"/>
                                        <RadioButton x:Name="TopMonth"   GroupName="TopFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Month"
                                                     Tag="month"   Click="TopFilter_Click"/>
                                        <RadioButton x:Name="TopOverall" GroupName="TopFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Overall"
                                                     Tag="overall" IsChecked="True" Click="TopFilter_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <StackPanel x:Name="TopTasksPanel"/>
                                <TextBlock x:Name="TopTasksEmpty"
                                           Text="No tracked time yet."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                        <!-- Busiest Hour -->
                        <Border Theme="{StaticResource SectionCard}" Padding="16,14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Busiest Hour" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Avg completions per active day  ·  7 AM – 9 PM  ·  last 30 days" TextWrapping="Wrap"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,2,0,10"/>
                                <UniformGrid x:Name="BusiestHourPanel" Rows="1"
                                            VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="BusiestHourEmpty"
                                           Text="No completion data yet."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                        <!-- Weekly Summary (time or task count toggle) -->
                        <Border Theme="{StaticResource SectionCard}" Padding="16,14" Margin="0,16,0,0">
                            <StackPanel>
                                <!-- Header with Time / Tasks toggle -->
                                <Grid Classes="cardHeader" Margin="0,0,0,2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="Weekly Summary" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <WrapPanel Classes="headerChips" ItemSpacing="4" LineSpacing="4" VerticalAlignment="Center">
                                        <RadioButton x:Name="WeeklyTimeToggle" GroupName="WeeklyMode"
                                                     Theme="{StaticResource FilterChip}" Content="Time"
                                                     IsChecked="True" Click="WeeklyToggle_Click"/>
                                        <RadioButton x:Name="WeeklyTaskToggle" GroupName="WeeklyMode"
                                                     Theme="{StaticResource FilterChip}" Content="Tasks"
                                                     Click="WeeklyToggle_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Text="Avg per active month  ·  last 12 months  ·  W1 = days 1–7,  W4 = days 22–end" TextWrapping="Wrap"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,2,0,10"/>
                                <ScrollViewer x:Name="WeeklyChartScroll"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="WeeklyChartPanel" Orientation="Horizontal"
                                                VerticalAlignment="Bottom"/>
                                </ScrollViewer>
                                <TextBlock x:Name="WeeklyChartEmpty"
                                           Text="No tracked time yet."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                        <!-- App Usage -->
                        <Border Theme="{StaticResource SectionCard}" Padding="16,14" Margin="0,16,0,16">
                            <StackPanel>
                                <Grid Classes="cardHeader" Margin="0,0,0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="App Usage" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="AppUsageSubtitle"
                                                   Text="Time spent in each Windows application  ·  top 10"
                                                   FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <WrapPanel Classes="headerChips" ItemSpacing="4" LineSpacing="4" VerticalAlignment="Top">
                                        <RadioButton x:Name="AppUsageToday" GroupName="AppUsageFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Today"
                                                     IsChecked="True" Tag="today"
                                                     Click="AppUsageFilter_Click"/>
                                        <RadioButton x:Name="AppUsageWeek" GroupName="AppUsageFilter"
                                                     Theme="{StaticResource FilterChip}" Content="This Week"
                                                     Tag="week" Click="AppUsageFilter_Click"/>
                                        <RadioButton x:Name="AppUsageMonth" GroupName="AppUsageFilter"
                                                     Theme="{StaticResource FilterChip}" Content="Month"
                                                     Tag="month" Click="AppUsageFilter_Click" Margin="0,0,8,0"/>
                                        <Button Click="AppUsageRefresh_Click"
                                                Theme="{StaticResource IconButton}"
                                                ToolTip.Tip="Refresh app usage"
                                                Width="26" Height="26" Padding="0">
                                            <ctrl:LineIcon Data="{StaticResource Icon.Refresh}"/>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                                <StackPanel x:Name="AppUsagePanel"/>
                                <TextBlock x:Name="AppUsageEmpty"
                                           Text="No app usage data yet — start using apps and check back."
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,4" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 5: Notifications & Reminders -->
            <Grid x:Name="RemindersPage" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Full-width segmented tab bar -->
                <Grid Grid.Row="0" Background="{DynamicResource HeaderBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="NotifTabBtn" Grid.Column="0"
                                 GroupName="ReminderTabs" IsChecked="True"
                                 Theme="{StaticResource ReminderTab}"
                                 HorizontalAlignment="Stretch"
                                 Content="Notifications"
                                 Click="NotifTab_Click">
                        <RadioButton.Tag><ctrl:LineIcon Data="{StaticResource Icon.Bell}" Size="16"/></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="UpcomingTabBtn" Grid.Column="1"
                                 GroupName="ReminderTabs"
                                 Theme="{StaticResource ReminderTab}"
                                 HorizontalAlignment="Stretch"
                                 Content="Upcoming Reminders"
                                 Click="UpcomingTab_Click">
                        <RadioButton.Tag><ctrl:LineIcon Data="{StaticResource Icon.Alarm}" Size="16"/></RadioButton.Tag>
                    </RadioButton>
                    <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1"
                            Background="{DynamicResource BorderColor}"/>
                </Grid>

                <!-- TAB 1: Notifications -->
                <ScrollViewer x:Name="NotifPanel" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <!-- NEW (unread) -->
                        <StackPanel x:Name="MissedSection" IsVisible="False" Margin="0,0,0,8">
                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource Danger}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="MissedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="8"
                                                Cursor="Hand" PointerReleased="MissedNotif_Click"
                                                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource PrimaryBlue}"
                                                BorderThickness="0,0,0,2" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding TaskIdDisplay}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBlue}"/>
                                                        <TextBlock Text="{Binding TaskTitle}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource PrimaryBlue}">
                                                        <InlineUIContainer BaselineAlignment="Center"><ctrl:LineIcon Data="{StaticResource Icon.Alarm}" Size="13" Margin="0,0,6,0"/></InlineUIContainer>
                                                        <Run Text="{Binding FiredAtDisplay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- SEEN (read) -->
                        <StackPanel x:Name="ReadSection" IsVisible="False">
                            <TextBlock Text="SEEN" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,0,0,6" Opacity="0.7"/>
                            <ItemsControl x:Name="ReadList" Opacity="0.65">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" CornerRadius="8"
                                                Cursor="Hand" PointerReleased="ReadNotif_Click"
                                                Background="{DynamicResource AppBackground}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding TaskIdDisplay}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBlue}"/>
                                                        <TextBlock Text="{Binding TaskTitle}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}">
                                                        <InlineUIContainer BaselineAlignment="Center"><ctrl:LineIcon Data="{StaticResource Icon.Alarm}" Size="13" Margin="0,0,6,0"/></InlineUIContainer>
                                                        <Run Text="{Binding FiredAtDisplay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Theme="{StaticResource IconButton}" Classes="delete"
                                                        ToolTip.Tip="Delete" VerticalAlignment="Center"
                                                        Tag="{Binding Id}" Click="DismissMissedNotif_Click">
                                                    <ctrl:LineIcon Data="{StaticResource Icon.Trash}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock x:Name="NotifEmptyLabel" Text="No notifications yet."
                                   Theme="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,32,0,0"
                                   IsVisible="False"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: Upcoming Reminders -->
                <ScrollViewer x:Name="UpcomingPanel" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Padding="16,12"
                              IsVisible="False">
                    <StackPanel>
                        <ItemsControl x:Name="RemindersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Theme="{StaticResource TaskCard}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="12,10,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding TaskIdDisplay}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBlue}"/>
                                                    <TextBlock Text="{Binding TaskTitle}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ctrl:LineIcon Data="{StaticResource Icon.Alarm}" Size="13" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource Warning}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FireDisplay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Warning}" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border Theme="{StaticResource Tag}" Classes="dueTag">
                                                        <TextBlock Text="{Binding FrequencyDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Theme="{StaticResource IconButton}" Classes="delete"
                                                    ToolTip.Tip="Delete reminder" VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    Tag="{Binding Id}" Click="DeleteReminder_Click">
                                                <ctrl:LineIcon Data="{StaticResource Icon.Trash}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RemindersEmptyLabel"
                                   Text="No upcoming reminders scheduled."
                                   Theme="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,32,0,0"
                                   IsVisible="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── PAGE: Settings ──────────────────────────────────────── -->
            <Grid x:Name="SettingsPage" IsVisible="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,12,16,16">

                    <!-- ROW 1: Profile + Appearance side by side — equal height via Grid stretch -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Labels -->
                        <TextBlock Classes="settingsPair profLabel"
                                   Text="PROFILE" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBlock Classes="settingsPair appLabel"
                                   Text="APPEARANCE" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>

                        <!-- Profile card -->
                        <Border Classes="settingsPair profCard"
                                Theme="{StaticResource SectionCard}" Padding="16,14"
                                VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Name" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="SettingUserName" Theme="{StaticResource InputBox}"
                                         Watermark="e.g. Muhammad Aadil"
                                         TextChanged="SettingUserName_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Appearance card — VerticalAlignment=Stretch matches Profile height -->
                        <Border Classes="settingsPair appCard"
                                Theme="{StaticResource SectionCard}" Padding="16,14"
                                VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Theme" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                <!-- WrapPanel: at larger text sizes the chips move to a new line instead of overflowing -->
                                <WrapPanel>
                                    <RadioButton x:Name="ThemeDark"  GroupName="ThemeSetting"
                                                 Theme="{StaticResource FilterChip}" Content="Dark"
                                                 Margin="0,0,6,6" Click="ThemeSetting_Click" Tag="{x:Static helpers:ThemePreferences.Dark}"/>
                                    <RadioButton x:Name="ThemeLight" GroupName="ThemeSetting"
                                                 Theme="{StaticResource FilterChip}" Content="Light"
                                                 Margin="0,0,6,6" Click="ThemeSetting_Click" Tag="{x:Static helpers:ThemePreferences.Light}"/>
                                    <RadioButton x:Name="ThemeAuto"  GroupName="ThemeSetting"
                                                 Theme="{StaticResource FilterChip}" Content="Auto"
                                                 Margin="0,0,6,6" Click="ThemeSetting_Click" Tag="{x:Static helpers:ThemePreferences.Auto}"/>
                                </WrapPanel>
                                <TextBlock Text="Zoom" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,6"/>
                                <!-- − 90 % + : makes the whole window smaller or larger (Ctrl/⌘ − + 0) -->
                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                    <Border Background="{DynamicResource InputBackground}" CornerRadius="999" Padding="4">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="ZoomOutBtn" Theme="{StaticResource IconButton}" Classes="accent"
                                                    CornerRadius="999" ToolTip.Tip="Smaller (Ctrl/⌘ −)" Click="ZoomOut_Click">
                                                <ctrl:LineIcon Data="{StaticResource Icon.Minus}" Size="16"/>
                                            </Button>
                                            <TextBlock x:Name="ZoomLabel" Width="56" TextAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button x:Name="ZoomInBtn" Theme="{StaticResource IconButton}" Classes="accent"
                                                    ToolTip.Tip="Larger (Ctrl/⌘ +)" Click="ZoomIn_Click">
                                                <ctrl:LineIcon Data="{StaticResource Icon.Plus}" Size="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="ZoomResetBtn" Theme="{StaticResource GhostButton}" Content="Reset"
                                            VerticalAlignment="Center" ToolTip.Tip="Back to the default size (Ctrl/⌘ 0)"
                                            Click="ZoomReset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ROW 2: Reminder Notifications — full width, stacked rows -->
                    <TextBlock Text="REMINDER NOTIFICATIONS" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Border Theme="{StaticResource SectionCard}" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>

                            <!-- Alert sound -->
                            <TextBlock Text="Alert sound" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <!-- Items come from the OS sound list (filled in code) -->
                                <ComboBox Grid.Column="0" x:Name="SettingTune"
                                          Theme="{StaticResource ThemedComboBox}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="SettingTune_Changed"/>
                                <Button Grid.Column="2" Theme="{StaticResource IconButton}" Classes="accent"
                                        Height="40" Width="34"
                                        ToolTip.Tip="Preview sound" Click="PreviewTune_Click">
                                    <ctrl:LineIcon Data="{StaticResource Icon.Play}" IsFilled="True" Size="12"/>
                                </Button>
                            </Grid>

                            <!-- Accent color -->
                            <TextBlock Text="Accent color" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="AccentBlue"   GroupName="AccentColor"
                                             Theme="{StaticResource FilterChip}" Content="Blue"
                                             Tag="#60A5FA" Margin="0,0,6,0" Click="AccentColor_Click"/>
                                <RadioButton x:Name="AccentGreen"  GroupName="AccentColor"
                                             Theme="{StaticResource FilterChip}" Content="Green"
                                             Tag="#22C55E" Margin="0,0,6,0" Click="AccentColor_Click"/>
                                <RadioButton x:Name="AccentOrange" GroupName="AccentColor"
                                             Theme="{StaticResource FilterChip}" Content="Orange"
                                             Tag="#FB923C" Margin="0,0,6,0" Click="AccentColor_Click"/>
                                <RadioButton x:Name="AccentPurple" GroupName="AccentColor"
                                             Theme="{StaticResource FilterChip}" Content="Purple"
                                             Tag="#A78BFA" Click="AccentColor_Click"/>
                            </StackPanel>

                            <!-- Auto-dismiss -->
                            <TextBlock Text="Auto-dismiss" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="DismissPerm" GroupName="DismissTime"
                                             Theme="{StaticResource FilterChip}" Content="Permanent"
                                             Tag="0" Margin="0,0,6,0" Click="DismissTime_Click"/>
                                <RadioButton x:Name="Dismiss15"   GroupName="DismissTime"
                                             Theme="{StaticResource FilterChip}" Content="15 s"
                                             Tag="15" Margin="0,0,6,0" Click="DismissTime_Click"/>
                                <RadioButton x:Name="Dismiss30"   GroupName="DismissTime"
                                             Theme="{StaticResource FilterChip}" Content="30 s"
                                             Tag="30" Margin="0,0,6,0" Click="DismissTime_Click"/>
                                <RadioButton x:Name="Dismiss60"   GroupName="DismissTime"
                                             Theme="{StaticResource FilterChip}" Content="60 s"
                                             Tag="60" Click="DismissTime_Click"/>
                            </StackPanel>

                            <!-- Test notification -->
                            <TextBlock Text="Test notification" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <Button x:Name="TestNotifBtn" Click="TestNotification_Click"
                                    Theme="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Padding="14,7"
                                    ToolTip.Tip="Fire a real reminder to verify your settings">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:LineIcon Data="{StaticResource Icon.Bell}" Size="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="Send test notification" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- ROW 3: Task Completion -->
                    <TextBlock Text="TASK COMPLETION" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Border Theme="{StaticResource SectionCard}" Padding="16,14" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Show completion popup"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Celebration dialog with confetti when a task is marked done"
                                           Theme="{StaticResource SubText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          x:Name="CompletionPopupToggle"
                                          AutomationProperties.Name="Show completion popup"
                                          Theme="{StaticResource ActiveToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Click="CompletionPopupToggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Theme="{StaticResource SectionCard}" Padding="16,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Save screenshot to Desktop"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="When off, the banner is only copied to clipboard"
                                           Theme="{StaticResource SubText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          x:Name="SaveScreenshotToggle"
                                          AutomationProperties.Name="Save screenshot to Desktop"
                                          Theme="{StaticResource ActiveToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Click="SaveScreenshotToggle_Click"/>
                        </Grid>
                    </Border>

                    <!-- ROW 4: Keyboard shortcuts (same list as the "?" sheet), collapsed until opened -->
                    <Border Theme="{StaticResource SectionCard}" Padding="0" Margin="0,0,0,14">
                        <StackPanel>
                            <ToggleButton x:Name="ShortcutsToggle" Theme="{StaticResource CollapsibleHeader}"
                                          IsChecked="False" Click="ShortcutsToggle_Click">
                                <StackPanel>
                                    <TextBlock Text="Keyboard shortcuts" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Press ? anywhere in the app to see them" Theme="{StaticResource SubText}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel x:Name="ShortcutsBody" IsVisible="False" Margin="16,0,16,14">
                                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,12"/>
                                <ctrl:ShortcutList/>
                                <Button Theme="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Padding="14,7" Margin="0,8,0,0" Click="ShowWelcomeTips_Click">
                                    <TextBlock Text="Show tips" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ROW 5: Data: one grouped card, a row per tool (icon tile · title · one line · action) -->
                    <TextBlock Text="DATA" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Border Theme="{StaticResource SectionCard}" Padding="0" Margin="0,0,0,14" ClipToBounds="True">
                        <StackPanel>
                            <!-- Recycle Bin: the whole row opens it -->
                            <Button Theme="{StaticResource SettingsRowButton}" Click="OpenTrash_Click">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="iconTile"><ctrl:LineIcon Data="{StaticResource Icon.Trash}"/></Border>
                                    <StackPanel Grid.Column="1" Classes="rowText">
                                        <TextBlock Classes="rowTitle" Text="Recycle Bin"/>
                                        <TextBlock Classes="rowSub" Text="Deleted tasks, kept for 30 days"/>
                                    </StackPanel>
                                    <ctrl:LineIcon Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Size="18"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Border Classes="rowDivider"/>

                            <!-- Backups -->
                            <StackPanel Classes="settingsRow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="iconTile"><ctrl:LineIcon Data="{StaticResource Icon.Lifebuoy}"/></Border>
                                    <StackPanel Grid.Column="1" Classes="rowText">
                                        <TextBlock Classes="rowTitle" Text="Backups"/>
                                        <TextBlock x:Name="BackupStatusText" Classes="rowSub"
                                                   ToolTip.Tip="A copy of your tasks and settings is saved every day. Attachment files stay where they are and are not copied."/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Classes="small"
                                            Content="Back up now" Click="BackUpNow_Click" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="48,12,0,0">
                                    <ComboBox x:Name="BackupPicker" Grid.Column="0" Theme="{StaticResource ThemedComboBox}"
                                              HorizontalAlignment="Stretch" PlaceholderText="No backups yet"/>
                                    <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Classes="small"
                                            Content="Restore…" Margin="8,0,0,0" Click="RestoreBackup_Click"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding #BackupPicker.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <Button Grid.Column="2" Theme="{StaticResource IconButton}" Classes="accent"
                                            Margin="4,0,0,0" ToolTip.Tip="Open backup folder" Click="OpenBackupFolder_Click"
                                            VerticalAlignment="Center">
                                        <ctrl:LineIcon Data="{StaticResource Icon.Folder}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <Border Classes="rowDivider"/>

                            <!-- Sync between computers (encrypted files in a cloud folder) -->
                            <Grid Classes="settingsRow" ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="iconTile"><ctrl:LineIcon Data="{StaticResource Icon.Refresh}"/></Border>
                                <StackPanel Grid.Column="1" Classes="rowText">
                                    <TextBlock Classes="rowTitle" Text="Sync"/>
                                    <TextBlock x:Name="SyncSubtitle" Classes="rowSub" Text="Same tasks on all your computers"/>
                                </StackPanel>
                                <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Classes="small"
                                        Content="Open" Click="Sync_Click" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Classes="rowDivider"/>

                            <!-- Migrate to another computer (encrypted export / import) -->
                            <Grid Classes="settingsRow" ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="iconTile"><ctrl:LineIcon Data="{StaticResource Icon.Monitor}"/></Border>
                                <StackPanel Grid.Column="1" Classes="rowText">
                                    <TextBlock Classes="rowTitle" Text="Move to another computer"/>
                                    <TextBlock x:Name="MigrateSubtitle" Classes="rowSub" Text="Everything in one password-protected file"/>
                                </StackPanel>
                                <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Classes="small"
                                        Content="Open" Click="Migrate_Click" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Classes="rowDivider"/>

                            <!-- Export / import for spreadsheets and other apps -->
                            <Grid Classes="settingsRow" ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="iconTile"><ctrl:LineIcon Data="{StaticResource Icon.Upload}"/></Border>
                                <StackPanel Grid.Column="1" Classes="rowText">
                                    <TextBlock Classes="rowTitle" Text="Export &amp; import"/>
                                    <TextBlock Classes="rowSub" Text="CSV, Markdown or a printable list"
                                               ToolTip.Tip="CSV opens in Excel, Numbers or Google Sheets. Print or save as PDF. Importing a CSV needs a Title column."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Theme="{StaticResource SecondaryButton}" Classes="small">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                                            <ctrl:LineIcon Data="{StaticResource Icon.ChevronDown}" Size="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="Tasks as CSV…" Click="ExportCsv_Click"/>
                                                <MenuItem Header="Tasks and notes as Markdown…" Click="ExportMarkdown_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Print or save as PDF">
                                                    <MenuItem Header="Today" Click="Print_Click" Tag="{x:Static vm:TaskFilter.Today}"/>
                                                    <MenuItem Header="This week" Click="Print_Click" Tag="{x:Static vm:TaskFilter.ThisWeek}"/>
                                                    <MenuItem Header="All open tasks" Click="Print_Click" Tag="{x:Static vm:TaskFilter.All}"/>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Theme="{StaticResource SecondaryButton}" Classes="small"
                                            Content="Import" Click="ImportCsv_Click" ToolTip.Tip="Import tasks from a CSV file"/>
                                </StackPanel>
                            </Grid>

                            <!-- Clear meeting history (Windows only) -->
                            <StackPanel x:Name="MeetingHistoryCard">
                                <Border Classes="rowDivider"/>
                                <Grid Classes="settingsRow" ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="iconTile"><ctrl:LineIcon Data="{StaticResource Icon.Video}"/></Border>
                                    <StackPanel Grid.Column="1" Classes="rowText">
                                        <TextBlock Classes="rowTitle" Text="Meeting history"/>
                                        <TextBlock Classes="rowSub" Text="Auto-detected meeting sessions"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="ClearMeetingHistoryBtn" Theme="{StaticResource SecondaryButton}"
                                            Classes="small" Content="Clear" Click="ClearMeetingHistory_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ROW 6: Updates (off unless the user turns it on) -->
                    <TextBlock Text="UPDATES" Theme="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Border Theme="{StaticResource SectionCard}" Padding="16,14" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Check for updates once a day"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Theme="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Only the version number is checked; nothing about you is sent. Off means Sysslar never goes online."/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="CheckUpdatesToggle"
                                              AutomationProperties.Name="Check for updates once a day"
                                              Theme="{StaticResource ActiveToggleSwitch}"
                                              VerticalAlignment="Center" Margin="10,0,0,0"
                                              Click="CheckUpdatesToggle_Click"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                <TextBlock x:Name="UpdateStatusText" Grid.Column="0" Theme="{StaticResource SubText}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="DownloadUpdateBtn" Theme="{StaticResource PrimaryButton}"
                                            Padding="12,6" Margin="8,0,0,0" IsVisible="False"
                                            Click="DownloadUpdate_Click">
                                        <TextBlock Text="Download" FontSize="12"/>
                                    </Button>
                                    <Button Theme="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0"
                                            Click="CheckUpdatesNow_Click">
                                        <TextBlock Text="Check now" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE: Recycle Bin -->
            <Grid x:Name="TrashPage" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Info banner -->
                <Border Grid.Row="0" Padding="16,12,16,0">
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               TextWrapping="Wrap"
                               Text="Deleted tasks are kept here for 30 days, then removed automatically. Restore puts a task back in its list."/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel x:Name="TrashEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Margin="0,60,0,0">
                            <ctrl:LineIcon Data="{StaticResource Icon.Trash}" Size="48" StrokeThickness="1.4"
                                           Foreground="{DynamicResource PlaceholderColor}" Opacity="0.6"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="The recycle bin is empty"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="TrashList" ItemsSource="{Binding DeletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TaskItemViewModel">
                                    <Border Theme="{StaticResource TaskCard}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding TaskNumberDisplay}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBlue}"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DeletedAtDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Theme="{StaticResource IconButton}" Classes="postpone"
                                                        ToolTip.Tip="Restore" Click="Restore_Click" Margin="0,0,4,0">
                                                    <ctrl:LineIcon Data="{StaticResource Icon.Undo}"/>
                                                </Button>
                                                <Button Theme="{StaticResource IconButton}" Classes="delete"
                                                        ToolTip.Tip="Delete permanently" Click="PermanentDelete_Click">
                                                    <ctrl:LineIcon Data="{StaticResource Icon.Trash}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid><!-- end page container -->


        <!-- Dim + blur overlay for modal dialogs -->
        <Border x:Name="DimOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource OverlayDim}"
                IsVisible="False"
                ZIndex="997"/>

        <!-- ═══ In-app notification overlay (bottom-right inside window) ═══ -->
        <Border x:Name="InAppNotifBorder" Grid.Row="0" Grid.RowSpan="3"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0,0,16,16"
                IsVisible="False"
                IsHitTestVisible="False"
                ZIndex="999">
            <Border x:Name="NotifMainBorder"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="14,10,8,10"
                    MinWidth="260" MaxWidth="420">
                <Border.Effect>
                    <DropShadowDirectionEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" Color="#000"/>
                </Border.Effect>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ctrl:LineIcon Grid.Column="0" x:Name="NotifIcon" Size="18"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="NotifMessage"
                               Foreground="{DynamicResource TextPrimary}" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <!-- Optional action such as "Undo" (the overlay only takes clicks while it is shown) -->
                    <Button Grid.Column="2" x:Name="NotifActionBtn" IsVisible="False"
                            Theme="{StaticResource GhostButton}" Padding="10,5"
                            Foreground="{DynamicResource PrimaryBlue}" FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Click="NotifAction_Click"/>
                </Grid>
            </Border>
        </Border>

        <!-- Workspace switch: covers the window while Sysslar restarts in the other workspace -->
        <Grid x:Name="SwitchOverlay" Grid.Row="0" Grid.RowSpan="3" ZIndex="1001" IsVisible="False"
              Background="{DynamicResource AppBackground}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <Panel Width="56" Height="56" HorizontalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource ChipBorder}" StrokeThickness="4"/>
                    <Arc x:Name="SwitchSpinner" Classes="spinner" Stroke="{DynamicResource PrimaryBlue}" StrokeThickness="4"
                         StrokeLineCap="Round" StartAngle="-90" SweepAngle="100" RenderTransformOrigin="50%,50%">
                        <Arc.RenderTransform><RotateTransform/></Arc.RenderTransform>
                    </Arc>
                    <Ellipse x:Name="SwitchDot" Width="14" Height="14" Fill="{DynamicResource PrimaryBlue}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Panel>
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="SwitchTitle" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="320"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="SwitchSub" Text="Getting things ready…" FontSize="13" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Confetti canvas -->
        <Canvas x:Name="ConfettiLayer" Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False"
                ZIndex="1000"/>

    </Grid>
    </LayoutTransformControl>
</Window>
