<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:Tasky.Controls"
             x:Class="Tasky.Views.NotePage">
    <Grid RowDefinitions="Auto,*">
        <!-- Header: Back · Note · Copy / Save -->
        <Border Grid.Row="0" Padding="16,12,16,0">
            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Theme="{StaticResource GhostButton}" Click="Back_Click"
                            Margin="-8,0,8,0" ToolTip.Tip="Back to notes (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ctrl:LineIcon Data="{StaticResource Icon.ChevronLeft}" Size="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Notes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" x:Name="HeaderTitle" Text="Note"
                               FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Theme="{StaticResource IconButton}" Classes="accent"
                                ToolTip.Tip="Copy description to clipboard" Click="CopyDesc_Click">
                            <ctrl:LineIcon Data="{StaticResource Icon.Clipboard}"/>
                        </Button>
                        <Button x:Name="SaveBtn" Content="Save" Theme="{StaticResource PrimaryButton}"
                                Padding="18,8" IsEnabled="False" Click="Save_Click"
                                ToolTip.Tip="Save changes (Ctrl+S / ⌘S)"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Body: sections in cards, scrolls when the note is long -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0">
            <StackPanel MaxWidth="720" Margin="0,16">

                <!-- Note -->
                <Border Theme="{StaticResource SectionCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:LineIcon Data="{StaticResource Icon.Note}" Size="15" Foreground="{DynamicResource PlaceholderColor}"/>
                            <TextBlock Text="NOTE" Theme="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Title" Theme="{StaticResource LabelText}"/>
                            <TextBox x:Name="TitleBox" Theme="{StaticResource InputBox}"
                                     FontSize="17" FontWeight="SemiBold"
                                     Watermark="Note title…" TextChanged="Field_Changed"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Description" Theme="{StaticResource LabelText}"/>
                            <TextBox x:Name="DescBox" Theme="{StaticResource InputBox}"
                                     MinHeight="220" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Watermark="Write your note…" TextChanged="Field_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tags -->
                <Border Theme="{StaticResource SectionCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:LineIcon Data="{StaticResource Icon.Tag}" Size="15" Foreground="{DynamicResource PlaceholderColor}"/>
                            <TextBlock Text="SEARCH TERMS / TAGS" Theme="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <TextBox x:Name="TagsBox" Theme="{StaticResource InputBox}"
                                 Watermark="Comma-separated tags, e.g. iphone, bluetooth, settings"
                                 TextChanged="Field_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Attachments: saved immediately, independent of Save -->
                <Border Theme="{StaticResource SectionCard}" Margin="0">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:LineIcon Data="{StaticResource Icon.Clip}" Size="15" Foreground="{DynamicResource PlaceholderColor}"/>
                            <TextBlock Text="ATTACHMENTS" Theme="{StaticResource SectionTitle}"/>
                            <TextBlock Text="· saved right away" FontSize="11"
                                       Foreground="{DynamicResource PlaceholderColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ctrl:AttachmentsPanel x:Name="Attachments"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
